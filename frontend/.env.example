# true: sample data from src/api/mock.js, no backend needed. false: call the backend.
VITE_USE_MOCK=true
# API base path. Keep /api to use the Vite proxy.
VITE_API_BASE_URL=/api
# Backend the Vite proxy forwards /api to when VITE_USE_MOCK=false
BACKEND_URL=http://localhost:8000
# Link behind "Contact an academic advisor"
VITE_ADVISOR_URL=mailto:advisor@example.edu
